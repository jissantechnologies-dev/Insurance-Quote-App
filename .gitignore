# User accounts and password hashes - created automatically on first run.
# Never commit: contains credentials, and pushing/deploying would overwrite
# the live user list on the server.
InsuranceQuoteApp/users.json

# Session signing secret - created automatically on first run.
# If this leaked, anyone could forge a login cookie without a password.
InsuranceQuoteApp/auth_secret.key

# Python bytecode
__pycache__/
*.pyc

# Excel lock files
~$*.xlsx

# pywhatkit's local send-history cache - only relevant to browser automation
# on your own machine; the hosted server never uses pywhatkit (no browser).
PyWhatKit_DB.txt

# Sent History and pending import batch for the Send Quote / Send Payment
# Link pages - live data written by the running server, same reasoning as
# users.json above.
InsuranceQuoteApp/sent_quote.json
InsuranceQuoteApp/sent_payment.json
InsuranceQuoteApp/batch_quote.json
InsuranceQuoteApp/batch_payment.json

# Uploaded customer documents (RC book, Aadhar, PAN, previous policy) - live
# data written by the running server, contains sensitive PII.
InsuranceQuoteApp/documents/
whatsapp_webhook.log
# WhatsApp conversation history written by the running server - live
# customer data, same reasoning as users.json above.
InsuranceQuoteApp/messages.db
InsuranceQuoteApp/messages.db-wal
InsuranceQuoteApp/messages.db-shm

# Inbound WhatsApp attachments - customer ID documents, downloaded from Meta
# when the webhook fires. Never commit: personal data, and the live server's
# copies are the real ones.
InsuranceQuoteApp/chat_media/

# Bulk quote campaign images and their index, plus the bulk send history -
# live data written by the running server, same reasoning as sent_quote.json
# above. The images are an agent's uploads, not part of the app.
InsuranceQuoteApp/campaigns/
InsuranceQuoteApp/campaigns.json
InsuranceQuoteApp/sent_bulk_quote.json

# Reminder send log - which policies have already been messaged.
InsuranceQuoteApp/reminders.db
InsuranceQuoteApp/reminders.log

# The active client list, the imported-leads scratch file and any customer
# workbook - live data written by the running server, and the reason
# production can start empty while dev keeps a full data set. The repo's
# starting copies live in InsuranceQuoteApp/seed/ and are only ever copied
# into a data directory on purpose (bootstrap_data.py --seed).
InsuranceQuoteApp/customers.json
InsuranceQuoteApp/newcustomer.txt
InsuranceQuoteApp/newcustomer.xlsx
InsuranceQuoteApp/customerxlfile.xlsx
